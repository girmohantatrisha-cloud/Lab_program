DESC Client_Master;

Q3. Calculate the profit (Sell_price - Cost_price) from the Products_Master table. Name the column as 'Profit'.

Answer:

SELECT Product_no, Description,
       Sell_price - Cost_price AS Profit
FROM Products_Master;

Q4. Calculate and display the total cost price (Qty_on_hand * Cost_price) of the stock present in hand. Name the column accordingly.

Answer:

SELECT Product_no, Description,
       Qty_on_hand * Cost_price AS Total_Stock_Cost
FROM Products_Master;

Q5. Display the client details of all the clients whose name starts with I.

Answer:

SELECT *
FROM Client_Master
WHERE Name LIKE 'I%';

Q6. Display the client details of all the clients whose name starts with R and ends with i.

Answer:

SELECT *
FROM Client_Master
WHERE Name LIKE 'R%i';

Q7. Display the client details of all the clients whose name contains a in the third and fifth position.

Answer:

SELECT *
FROM Client_Master
WHERE SUBSTR(Name, 3, 1) = 'a'
AND SUBSTR(Name, 5, 1) = 'a';

Q8. Display the client details of all the clients whose name contains aa.

Answer:

SELECT *
FROM Client_Master
WHERE Name LIKE '%aa%';

Q9. Display the client details of all the clients whose name contains exactly four characters.

Answer:

SELECT *
FROM Client_Master
WHERE LENGTH(Name) = 4;

Q10. Display the client details of those clients who have not mentioned state in his/her address.

Answer:

SELECT *
FROM Client_Master
WHERE State IS NULL;

Q11. Display the order details placed after January, 1996.

Answer:

SELECT *
FROM Sales_Order
WHERE S_order_date > TO_DATE('31-JAN-1996', 'DD-MON-YYYY');

Q12. Change the S_order_date of client_no 'C01' to 24/07/96, Product_no to 'P06', Salesman_no to 'S04'.

Answer:

