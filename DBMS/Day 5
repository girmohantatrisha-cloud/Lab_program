Q13. Change the city of client_no 'C05' to 'Kolkata'.

Answer:

ALTER TABLE Client_Master
DROP CONSTRAINT chk_city;

ALTER TABLE Client_Master
ADD CONSTRAINT chk_city
CHECK (City IN ('Delhi', 'Mumbai', 'Chennai', 'Kolkata'));

UPDATE Client_Master
SET City = 'Kolkata'
WHERE Client_no = 'C05';

COMMIT;

