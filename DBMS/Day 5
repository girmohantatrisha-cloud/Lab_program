Q17. Create a table of your own with a composite primary key.

Answer:

CREATE TABLE Student_Course (
    Student_ID NUMBER(5),
    Course_ID NUMBER(5),
    Course_Name VARCHAR2(20),

    CONSTRAINT pk_student_course
    PRIMARY KEY (Student_ID, Course_ID)
);

Q18. Create another table of your own wish, where the composite primary key of Question 17 will act as a foreign key here.

Answer:

CREATE TABLE Student_Result (
    Result_ID NUMBER(5),
    Student_ID NUMBER(5),
    Course_ID NUMBER(5),
    Marks NUMBER(5),

    CONSTRAINT pk_student_result
    PRIMARY KEY (Result_ID),

    CONSTRAINT fk_student_course
    FOREIGN KEY (Student_ID, Course_ID)
    REFERENCES Student_Course(Student_ID, Course_ID)
);
